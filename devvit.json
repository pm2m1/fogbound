{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "fogbound",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "journeys": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-rollover": {
        "endpoint": "/internal/scheduler/daily-rollover",
        "cron": "0 0 * * *"
      },
      "daily-rollover-retry": {
        "endpoint": "/internal/scheduler/daily-rollover",
        "cron": "10 0 * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Fogbound: post today's fog",
        "description": "Creates today's puzzle post if the scheduler missed it",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "dev": {
    "subreddit": "fogbounddev"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
