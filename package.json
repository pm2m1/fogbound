{
  "private": true,
  "name": "fogbound-bay",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "tsx --test src/shared/*.test.ts",
    "test:server": "vitest run",
    "test": "npm run test:unit && npm run test:server && npm run test:types",
    "type-check": "tsc --build"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.4",
    "@devvit/start": "0.15.4",
    "@devvit/web": "0.15.4",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.4",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "^3.2.7"
  }
}